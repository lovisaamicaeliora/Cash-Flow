                                padding: [0, dp(14)]
                                background_color: 0, 0, 0, 0
                                pos_hint: {"center_y": .5}
                                hint_text_color: get_color_from_hex("#8E8E93")
                                foreground_color: get_color_from_hex("#1A1A1A")
                                on_focus: if self.focus: root.open_date_picker()

                MDBoxLayout:
                    orientation: 'vertical'
                    spacing: "4dp"
                    size_hint_y: None
                    height: self.minimum_height

                    MDLabel:
                        text: "Nominal"
                        bold: True
                        font_size: "14sp"
                        size_hint_y: None
                        height: "22dp"
                        text_size: self.size
                        valign: "middle"
                        theme_text_color: "Custom"
                        text_color: get_color_from_hex("#1A1A1A")

                    MDCard:
                        radius: [14,]
                        elevation: 0
                        md_bg_color: 1, 1, 1, 1
                        size_hint_y: None
                        height: "50dp"
                        padding: ["12dp", "0dp", "12dp", "0dp"]

                        MDBoxLayout:
                            spacing: "10dp"
                            pos_hint: {"center_y": .5}

                            MDIcon:
                                icon: "currency-usd"
                                user_font_size: "18sp"
                                pos_hint: {"center_y": .5}
                                theme_text_color: "Custom"
                                text_color: get_color_from_hex("#8E8E93")

                            TextInput:
                                id: amount_input
                                hint_text: "Masukkan nominal"
                                input_filter: "int"
                                multiline: False
                                font_size: "14sp"
                                padding: [0, dp(14)]
                                background_color: 0, 0, 0, 0
                                pos_hint: {"center_y": .5}
                                hint_text_color: get_color_from_hex("#8E8E93")
                                foreground_color: get_color_from_hex("#1A1A1A")

                MDBoxLayout:
                    orientation: 'vertical'
                    spacing: "4dp"
                    size_hint_y: None
                    height: self.minimum_height

                    MDLabel:
                        text: "Keterangan"
                        bold: True
                        font_size: "14sp"
                        size_hint_y: None
                        height: "22dp"
                        text_size: self.size
                        valign: "middle"
                        theme_text_color: "Custom"
                        text_color: get_color_from_hex("#1A1A1A")

                    MDCard:
                        radius: [14,]
                        elevation: 0
                        md_bg_color: 1, 1, 1, 1
                        size_hint_y: None
                        height: "50dp"
                        padding: ["12dp", "0dp", "12dp", "0dp"]

                        MDBoxLayout:
                            spacing: "10dp"
                            pos_hint: {"center_y": .5}

                            MDIcon:
                                icon: "text-box-outline"
                                user_font_size: "18sp"
                                pos_hint: {"center_y": .5}
                                theme_text_color: "Custom"
                                text_color: get_color_from_hex("#8E8E93")

                            TextInput:
                                id: desc_input
                                hint_text: "Berikan keterangan"
                                multiline: False
                                font_size: "14sp"
                                padding: [0, dp(14)]
                                background_color: 0, 0, 0, 0
                                pos_hint: {"center_y": .5}
                                hint_text_color: get_color_from_hex("#8E8E93")
                                foreground_color: get_color_from_hex("#1A1A1A")

                Widget:
                    size_hint_y: None
                    height: "10dp"

                MDRaisedButton:
                    text: "Simpan"
                    md_bg_color: get_color_from_hex("#278B58")
                    size_hint_x: 1
                    size_hint_y: None
                    height: "50dp"
                    on_release: root.save_income()

<ExpenseScreen>:
    MDBoxLayout:
