<StatisticScreen>:
    MDBoxLayout:
        orientation: 'vertical'
        md_bg_color: get_color_from_hex("#FAF8F5")

        MDBoxLayout:
            orientation: 'vertical'
            padding: ["20dp", "16dp", "20dp", "16dp"]
            spacing: "12dp"

            # 1. Header Bar
            MDBoxLayout:
                adaptive_height: True
                MDLabel:
                    text: "Statistik"
                    font_style: "H6"
                    bold: True
                    pos_hint: {"center_y": .5}
                    theme_text_color: "Custom"
                    text_color: get_color_from_hex("#1A1A1A")

            # 2. Selector Bulan
            MDCard:
                radius: [16,]
                elevation: 0
                md_bg_color: 1, 1, 1, 1
                size_hint_y: None
                height: "50dp"
                padding: ["12dp", "0dp", "12dp", "0dp"]

                MDBoxLayout:
                    MDIconButton:
                        icon: "chevron-left"
                        pos_hint: {"center_y": .5}
                        on_release: root.change_month(-1)

                    Widget:

                    MDBoxLayout:
                        adaptive_size: True
                        spacing: "8dp"
                        pos_hint: {"center_y": .5}

                        MDIcon:
                            icon: "calendar-month-outline"
                            size_hint: None, None
                            size: "20dp", "20dp"
                            font_size: "20sp"
                            pos_hint: {"center_y": .5}
                            theme_text_color: "Custom"
                            text_color: get_color_from_hex("#278B58")

                        MDLabel:
                            id: selected_month_label
                            text: "September 2026"
                            bold: True
                            adaptive_size: True
                            pos_hint: {"center_y": .5}

                    Widget:

                    MDIconButton:
                        icon: "chevron-right"
                        pos_hint: {"center_y": .5}
                        on_release: root.change_month(1)

            # 3. Summary Cards
            MDBoxLayout:
                spacing: "12dp"
                size_hint_y: None
                height: "85dp"

                MDCard:
                    radius: [16,]
                    elevation: 0
                    md_bg_color: 1, 1, 1, 1
                    padding: "12dp"
                    MDBoxLayout:
                        orientation: 'vertical'
                        spacing: "2dp"
                        MDLabel:
                            text: "Pemasukan Bulan Ini"
                            font_style: "Caption"
                            theme_text_color: "Custom"
                            text_color: get_color_from_hex("#8E8E93")
                        MDLabel:
                            id: stat_income_label
                            text: "Rp 0"
                            font_style: "Subtitle1"
                            bold: True

                MDCard:
                    radius: [16,]
                    elevation: 0
                    md_bg_color: 1, 1, 1, 1
                    padding: "12dp"
                    MDBoxLayout:
                        orientation: 'vertical'
                        spacing: "2dp"
                        MDLabel:
                            text: "Pengeluaran Bulan Ini"
                            font_style: "Caption"
                            theme_text_color: "Custom"
                            text_color: get_color_from_hex("#8E8E93")
                        MDLabel:
                            id: stat_expense_label
                            text: "Rp 0"
                            font_style: "Subtitle1"
                            bold: True

            # 4. Card Tren 3 Bulan Terakhir (Grafik)
            MDCard:
                radius: [16,]
                elevation: 0
                md_bg_color: 1, 1, 1, 1
                size_hint_y: 1
                padding: "16dp"

                MDBoxLayout:
                    orientation: 'vertical'
                    spacing: "8dp"

                    MDLabel:
                        text: "Tren 3 Bulan Terakhir"
                        font_style: "Subtitle1"
                        bold: True
                        adaptive_height: True

                    # Indikator Legenda Pemasukan & Pengeluaran bersisian
                    MDBoxLayout:
                        adaptive_height: True
                        spacing: "20dp"

                        MDBoxLayout:
                            adaptive_size: True
                            spacing: "6dp"
                            MDIcon:
                                icon: "circle"
                                font_size: "10sp"
                                size_hint: None, None
                                size: "10dp", "10dp"
                                theme_text_color: "Custom"
                                text_color: get_color_from_hex("#278B58")
                                pos_hint: {"center_y": .5}
                            MDLabel:
                                text: "Pemasukan"
                                font_style: "Caption"
                                adaptive_size: True
                                theme_text_color: "Custom"
                                text_color: get_color_from_hex("#8E8E93")
                                pos_hint: {"center_y": .5}

                        MDBoxLayout:
                            adaptive_size: True
                            spacing: "6dp"
                            MDIcon:
                                icon: "circle"
                                font_size: "10sp"
                                size_hint: None, None
                                size: "10dp", "10dp"
                                theme_text_color: "Custom"
                                text_color: get_color_from_hex("#E53935")
                                pos_hint: {"center_y": .5}
                            MDLabel:
                                text: "Pengeluaran"
                                font_style: "Caption"
                                adaptive_size: True
                                theme_text_color: "Custom"
                                text_color: get_color_from_hex("#8E8E93")
                                pos_hint: {"center_y": .5}

                    FloatLayout:
                        id: chart_container
                        size_hint: 1, 1

        # 5. Bottom Navigation Bar
        MDCard:
            radius: [0, 0, 0, 0]
            elevation: 0
            md_bg_color: 1, 1, 1, 1
            size_hint_y: None
            height: "60dp"

            MDBoxLayout:
                orientation: 'horizontal'

                MDBoxLayout:
                    orientation: 'vertical'
                    padding: ["0dp", "6dp", "0dp", "6dp"]
                    spacing: "2dp"
                    on_touch_down: if self.collide_point(*args[1].pos): root.manager.current = "home"
                    MDIcon:
                        icon: "home-outline"
                        pos_hint: {"center_x": .5}
                        theme_text_color: "Custom"
                        text_color: get_color_from_hex("#8E8E93")
                    MDLabel:
                        text: "Beranda"
                        halign: "center"
                        font_style: "Caption"
                        theme_text_color: "Custom"
                        text_color: get_color_from_hex("#8E8E93")

                MDBoxLayout:
                    orientation: 'vertical'
                    padding: ["0dp", "6dp", "0dp", "6dp"]
                    spacing: "2dp"
                    MDIcon:
                        icon: "arrow-top-right"
                        pos_hint: {"center_x": .5}
                        theme_text_color: "Custom"
                        text_color: get_color_from_hex("#278B58")
                    MDLabel:
                        text: "Statistik"
                        halign: "center"
                        bold: True
                        font_style: "Caption"
                        theme_text_color: "Custom"
                        text_color: get_color_from_hex("#278B58")

                MDBoxLayout:
                    orientation: 'vertical'
                    padding: ["0dp", "6dp", "0dp", "6dp"]
                    spacing: "2dp"
                    on_touch_down: if self.collide_point(*args[1].pos): root.manager.current = "history"
                    MDIcon:
                        icon: "text-box-outline"
                        pos_hint: {"center_x": .5}
                        theme_text_color: "Custom"
                        text_color: get_color_from_hex("#8E8E93")
                    MDLabel:
                        text: "Riwayat"
                        halign: "center"
                        font_style: "Caption"
                        theme_text_color: "Custom"
                        text_color: get_color_from_hex("#8E8E93")
<HistoryScreen>:
    MDBoxLayout:
        orientation: 'vertical'
        md_bg_color: get_color_from_hex("#FAF8F5")

        ScrollView:
            do_scroll_x: False

            MDBoxLayout:
                orientation: 'vertical'
                padding: ["20dp", "20dp", "20dp", "20dp"]
                spacing: "16dp"
                size_hint_y: None
                height: self.minimum_height

                MDBoxLayout:
                    adaptive_height: True
                    spacing: "0dp"

                    MDLabel:
                        text: "Riwayat"
                        font_style: "H6"
                        bold: True
                        pos_hint: {"center_y": .5}
                        theme_text_color: "Custom"
                        text_color: get_color_from_hex("#1A1A1A")

                MDCard:
                    radius: [20, 20, 20, 20]
                    elevation: 0
                    md_bg_color: 1, 1, 1, 1
                    size_hint_y: None
                    height: "54dp"
                    padding: ["12dp", "0dp", "12dp", "0dp"]

                    MDBoxLayout:
                        MDIconButton:
                            icon: "chevron-left"
                            pos_hint: {"center_y": .5}
                            on_release: root.change_month(-1)

                        Widget:

                        MDBoxLayout:
                            adaptive_size: True
                            spacing: "12dp"
                            pos_hint: {"center_y": .5}

                            MDIcon:
                                icon: "calendar-month-outline"
                                size_hint: None, None
                                size: "22dp", "22dp"
                                font_size: "22sp"
                                pos_hint: {"center_y": .5}
                                theme_text_color: "Custom"
                                text_color: get_color_from_hex("#278B58")

                            MDLabel:
                                id: history_month_label
                                text: "September 2026"
                                bold: True
                                adaptive_size: True
                                pos_hint: {"center_y": .5}

                        Widget:

                        MDIconButton:
                            icon: "chevron-right"
                            pos_hint: {"center_y": .5}
                            on_release: root.change_month(1)

               # Filter Buttons
                MDBoxLayout:
                    adaptive_height: True
                    spacing: "6dp"

                    MDFillRoundFlatButton:
                        id: btn_filter_all
                        text: "Semua"
                        elevation: 0
                        ripple_scale: 0         # Mematikan efek gelombang ripple
                        focus_color: [0,0,0,0]  # Mematikan bayangan kelabu semasa difokus
                        md_bg_color: get_color_from_hex("#278B58")
                        text_color: 1, 1, 1, 1
                        size_hint: None, None
                        size: "72dp", "34dp"
                        font_size: "12sp"
                        radius: [18, 18, 18, 18]
                        on_press: root.filter_transactions("all")   # Menggunakan on_press agar tindak balas serta-merta

                    MDFillRoundFlatButton:
                        id: btn_filter_income
                        text: "Pemasukan"
                        elevation: 0
                        ripple_scale: 0
                        focus_color: [0,0,0,0]
                        md_bg_color: 1, 1, 1, 1
                        text_color: get_color_from_hex("#8E8E93")
                        size_hint: None, None
                        size: "102dp", "34dp"
                        font_size: "12sp"
                        radius: [18, 18, 18, 18]
                        on_press: root.filter_transactions("income")

                    MDFillRoundFlatButton:
                        id: btn_filter_expense
                        text: "Pengeluaran"
                        elevation: 0
                        ripple_scale: 0
                        focus_color: [0,0,0,0]
                        md_bg_color: 1, 1, 1, 1
                        text_color: get_color_from_hex("#8E8E93")
                        size_hint: None, None
                        size: "112dp", "34dp"
                        font_size: "12sp"
                        radius: [18, 18, 18, 18]
                        on_press: root.filter_transactions("expense")
                        
                MDBoxLayout:
                    id: history_list_container
                    orientation: 'vertical'
                    spacing: "12dp"
                    size_hint_y: None
                    height: self.minimum_height

                MDLabel:
                    id: history_empty_label
                    text: "Belum ada transaksi pada bulan ini"
                    opacity: 0
                    size_hint_y: None
                    height: "0dp"
                    halign: "center"
                    valign: "middle"
                    text_size: self.size
                    font_style: "Caption"
                    theme_text_color: "Custom"
                    text_color: get_color_from_hex("#8E8E93")

        MDCard:
            radius: [16, 16, 16, 16]
            elevation: 0
            md_bg_color: get_color_from_hex("#1E6B45")
            size_hint: 1, None
            height: "70dp"
            padding: ["16dp", "12dp", "16dp", "12dp"]

            MDBoxLayout:
                spacing: "12dp"

                MDCard:
                    radius: [12, 12, 12, 12]
                    elevation: 0
                    md_bg_color: 1, 1, 1, 0.2
                    size_hint: None, None
                    size: "44dp", "44dp"
                    pos_hint: {"center_y": .5}

                    MDRelativeLayout:
                        size: self.parent.size
                        pos_hint: {"center_x": .5, "center_y": .5}

                        MDIcon:
                            icon: "wallet-outline"
                            size_hint: None, None
                            size: "24dp", "24dp"
                            pos_hint: {"center_x": .5, "center_y": .5}
                            theme_text_color: "Custom"
                            text_color: 1, 1, 1, 1

                MDBoxLayout:
                    orientation: 'vertical'
                    pos_hint: {"center_y": .5}
                    spacing: "2dp"

                    MDLabel:
                        text: "Saldo Akhir"
                        font_style: "Caption"
                        theme_text_color: "Custom"
                        text_color: 1, 1, 1, 0.8

                    MDLabel:
                        id: history_total_balance
                        text: "Rp 0"
                        font_style: "Subtitle1"
                        bold: True
                        theme_text_color: "Custom"
                        text_color: 1, 1, 1, 1

        MDCard:
            radius: [0, 0, 0, 0]
            elevation: 0
            md_bg_color: 1, 1, 1, 1
            size_hint_y: None
            height: "64dp"

            MDBoxLayout:
                orientation: 'horizontal'

                MDBoxLayout:
                    orientation: 'vertical'
                    padding: ["0dp", "8dp", "0dp", "8dp"]
                    spacing: "2dp"
                    on_touch_down: if self.collide_point(*args[1].pos): root.manager.current = "home"

                    MDIcon:
                        icon: "home-outline"
                        pos_hint: {"center_x": .5}
                        theme_text_color: "Custom"
                        text_color: get_color_from_hex("#8E8E93")

                    MDLabel:
                        text: "Beranda"
                        halign: "center"
                        font_style: "Caption"
                        theme_text_color: "Custom"
                        text_color: get_color_from_hex("#8E8E93")

                MDBoxLayout:
                    orientation: 'vertical'
                    padding: ["0dp", "8dp", "0dp", "8dp"]
                    spacing: "2dp"
                    on_touch_down: if self.collide_point(*args[1].pos): root.manager.current = "statistic"

                    MDIcon:
                        icon: "arrow-top-right"
                        pos_hint: {"center_x": .5}
                        theme_text_color: "Custom"
                        text_color: get_color_from_hex("#8E8E93")

                    MDLabel:
                        text: "Statistik"
                        halign: "center"
                        font_style: "Caption"
                        theme_text_color: "Custom"
                        text_color: get_color_from_hex("#8E8E93")

                MDBoxLayout:
                    orientation: 'vertical'
                    padding: ["0dp", "8dp", "0dp", "8dp"]
                    spacing: "2dp"

                    MDIcon:
                        icon: "text-box-outline"
                        pos_hint: {"center_x": .5}
                        theme_text_color: "Custom"
                        text_color: get_color_from_hex("#278B58")

                    MDLabel:
                        text: "Riwayat"
                        halign: "center"
                        bold: True
                        font_style: "Caption"
                        theme_text_color: "Custom"
                        text_color: get_color_from_hex("#278B58")

<DetailScreen>:
    MDBoxLayout:
        orientation: 'vertical'
        md_bg_color: get_color_from_hex("#FAF8F5")
        padding: ["20dp", "20dp", "20dp", "20dp"]
        spacing: "24dp"

        MDLabel:
            text: "Detail"
            font_style: "H6"
            bold: True
            size_hint_y: None
            height: self.texture_size[1]
            theme_text_color: "Custom"
            text_color: get_color_from_hex("#1A1A1A")

        ScrollView:
            do_scroll_x: False

            MDBoxLayout:
                orientation: 'vertical'
                spacing: "16dp"
                padding: [0, "4dp", 0, "12dp"]
                adaptive_height: True

                MDCard:
                    id: detail_icon_bg
                    radius: [30, 30, 30, 30]
                    elevation: 0
                    md_bg_color: get_color_from_hex("#278B58")
                    size_hint: None, None
                    size: "72dp", "72dp"
                    pos_hint: {"center_x": .5}

                    MDRelativeLayout:
                        size: self.parent.size
                        pos_hint: {"center_x": .5, "center_y": .5}

                        MDIcon:
                            id: detail_icon
                            icon: "plus"
                            size_hint: None, None
                            size: "32dp", "32dp"
                            font_size: "32sp"
                            pos_hint: {"center_x": .5, "center_y": .5}
                            theme_text_color: "Custom"
                            text_color: 1, 1, 1, 1

                MDLabel:
                    id: detail_type_label
                    text: "Pemasukan"
                    font_style: "Subtitle1"
                    bold: True
                    size_hint_y: None
                    height: "30dp"
                    text_size: self.size
                    valign: "middle"
                    halign: "center"
                    theme_text_color: "Custom"
                    text_color: get_color_from_hex("#1A1A1A")

                MDCard:
                    radius: [20, 20, 20, 20]
                    elevation: 0
                    md_bg_color: 1, 1, 1, 1
                    size_hint_y: None
                    height: "220dp"
                    padding: "20dp"

                    MDBoxLayout:
                        orientation: 'vertical'
                        spacing: "10dp"

                        MDBoxLayout:
                            orientation: 'vertical'
                            spacing: "4dp"
                            size_hint_y: None
                            height: "54dp"

                            MDLabel:
                                text: "Nominal"
                                font_style: "Caption"
                                size_hint_y: None
                                height: "20dp"
                                theme_text_color: "Custom"
                                text_color: get_color_from_hex("#8E8E93")

                            MDLabel:
                                id: detail_amount_label
                                text: "Rp 10.000"
                                font_style: "Subtitle1"
                                bold: True
                                size_hint_y: None
                                height: "28dp"
                                theme_text_color: "Custom"
                                text_color: get_color_from_hex("#1A1A1A")

                        MDBoxLayout:
                            orientation: 'vertical'
                            spacing: "4dp"
                            size_hint_y: None
                            height: "54dp"

                            MDLabel:
                                text: "Keterangan"
                                font_style: "Caption"
                                size_hint_y: None
                                height: "20dp"
                                theme_text_color: "Custom"
                                text_color: get_color_from_hex("#8E8E93")

                            MDLabel:
                                id: detail_desc_label
                                text: "Sisa uang jajan"
                                font_style: "Subtitle1"
                                bold: True
                                size_hint_y: None
                                height: "28dp"
                                text_size: self.size
                                shorten: True
                                shorten_from: "right"
                                theme_text_color: "Custom"
                                text_color: get_color_from_hex("#1A1A1A")

                        MDBoxLayout:
                            orientation: 'vertical'
                            spacing: "4dp"
                            size_hint_y: None
                            height: "54dp"

                            MDLabel:
                                text: "Tanggal"
                                font_style: "Caption"
                                size_hint_y: None
                                height: "20dp"
                                theme_text_color: "Custom"
                                text_color: get_color_from_hex("#8E8E93")

                            MDLabel:
                                id: detail_date_label
                                text: "12 Sep 2026"
                                font_style: "Subtitle1"
                                bold: True
                                size_hint_y: None
                                height: "28dp"
                                theme_text_color: "Custom"
                                text_color: get_color_from_hex("#1A1A1A")

                MDRaisedButton:
                    id: detail_back_button
                    text: "Kembali"
                    md_bg_color: get_color_from_hex("#278B58")
                    text_color: 1, 1, 1, 1
                    size_hint_x: 1
                    size_hint_y: None
                    height: "50dp"
                    on_release: root.manager.current = "history"