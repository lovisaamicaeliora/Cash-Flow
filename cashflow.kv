#:import Clock kivy.clock.Clock
#:import dp kivy.metrics.dp
#:import get_color_from_hex kivy.utils.get_color_from_hex

<CustomTextInput@TextInput>:
    multiline: False
    size_hint_y: None
    height: "48dp"
    padding: ["12dp", "12dp"]
    background_normal: ""
    background_color: 0.95, 0.95, 0.95, 1

<SplashScreen>:
    canvas.before:
        Color:
            rgba: 0.96, 0.95, 0.91, 1
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        orientation: 'vertical'
        padding: "30dp"
        spacing: "15dp"

        Widget:
            size_hint_y: 0.2

        Image:
            source: root.logo_path
            size_hint: (None, None)
            size: ("170dp", "170dp")
            pos_hint: {"center_x": 0.5}

        Label:
            text: "Catat. Kelola. Pantau\nKeuanganmu."
            font_size: "14sp"
            halign: "center"
            color: 0.5, 0.5, 0.5, 1
            size_hint_y: None
            height: "40dp"

        Widget:
            size_hint_y: 0.3

<LoginScreen>:
    canvas.before:
        Color:
            rgba: 0.96, 0.95, 0.91, 1
        Rectangle:
            pos: self.pos
            size: self.size

    ScrollView:
        BoxLayout:
            orientation: 'vertical'
            padding: [dp(24), dp(40), dp(24), dp(20)]
            spacing: dp(12)
            size_hint_y: None
            height: self.minimum_height

            Image:
                source: root.logo_path
                size_hint: (None, None)
                size: ("80dp", "80dp")
                pos_hint: {"center_x": 0.5}

            Label:
                text: "Selamat datang kembali!"
                font_size: "20sp"
                bold: True
                color: 0.1, 0.1, 0.1, 1
                size_hint_y: None
                height: "30dp"

            Label:
                text: "Masuk untuk melanjutkan"
                font_size: "12sp"
                color: 0.5, 0.5, 0.5, 1
                size_hint_y: None
                height: "20dp"

            Widget:
                size_hint_y: None
                height: "10dp"

            Label:
                text: "Email"
                font_size: "12sp"
                color: 0.2, 0.2, 0.2, 1
                size_hint_y: None
                height: "20dp"
                halign: "left"
                text_size: self.size

            CustomTextInput:
                id: login_email
                hint_text: "contoh: nama@gmail.com"

            Label:
                text: "Password"
                font_size: "12sp"
                color: 0.2, 0.2, 0.2, 1
                size_hint_y: None
                height: "20dp"
                halign: "left"
                text_size: self.size

            CustomTextInput:
                id: login_password
                hint_text: "Masukkan password"
                password: True

            Label:
                id: login_message
                text: ""
                font_size: "12sp"
                color: 0.9, 0.2, 0.2, 1
                size_hint_y: None
                height: "20dp"

            Button:
                text: "Masuk"
                size_hint_y: None
                height: "48dp"
                background_normal: ''
                background_color: 0.13, 0.55, 0.35, 1
                color: 1, 1, 1, 1
                bold: True
                on_press: root.do_login()

            BoxLayout:
                orientation: 'horizontal'
                size_hint_y: None
                height: "40dp"
                alignment: 'center'

                Label:
                    text: "Belum punya akun? "
                    font_size: "12sp"
                    color: 0.5, 0.5, 0.5, 1
                    size_hint_x: None
                    width: self.texture_size[0]

                Button:
                    text: "Daftar di sini"
                    font_size: "12sp"
                    color: 0.13, 0.55, 0.35, 1
                    bold: True
                    background_color: 0, 0, 0, 0
                    size_hint_x: None
                    width: self.texture_size[0]
                    on_press: app.root.current = 'register'

<RegisterScreen>:
    canvas.before:
        Color:
            rgba: 0.96, 0.95, 0.91, 1
        Rectangle:
            pos: self.pos
            size: self.size

    ScrollView:
        BoxLayout:
            orientation: 'vertical'
            padding: ["24dp", "30dp", "24dp", "20dp"]
            spacing: "10dp"
            size_hint_y: None
            height: self.minimum_height

            Image:
                source: root.logo_path
                size_hint: (None, None)
                size: ("70dp", "70dp")
                pos_hint: {"center_x": 0.5}

            Label:
                text: "Buat Akun"
                font_size: "20sp"
                bold: True
                color: 0.1, 0.1, 0.1, 1
                size_hint_y: None
                height: "28dp"

            Label:
                text: "Masukkan data untuk membuat akun baru"
                font_size: "12sp"
                color: 0.5, 0.5, 0.5, 1
                size_hint_y: None
                height: "18dp"

            Label:
                text: "Nama"
                font_size: "12sp"
                color: 0.2, 0.2, 0.2, 1
                size_hint_y: None
                height: "18dp"
                halign: "left"
                text_size: self.size

            CustomTextInput:
                id: reg_name
                hint_text: "Nama"

            Label:
                text: "Email"
                font_size: "12sp"
                color: 0.2, 0.2, 0.2, 1
                size_hint_y: None
                height: "18dp"
                halign: "left"
                text_size: self.size

            CustomTextInput:
                id: reg_email
                hint_text: "contoh: nama@gmail.com"

            Label:
                text: "Password"
                font_size: "12sp"
                color: 0.2, 0.2, 0.2, 1
                size_hint_y: None
                height: "18dp"
                halign: "left"
                text_size: self.size

            CustomTextInput:
                id: reg_password
                hint_text: "Password"
                password: True

            Label:
                text: "Konfirmasi password"
                font_size: "12sp"
                color: 0.2, 0.2, 0.2, 1
                size_hint_y: None
                height: "18dp"
                halign: "left"
                text_size: self.size

            CustomTextInput:
                id: reg_confirm_password
                hint_text: "Konfirmasi password"
                password: True

            Label:
                id: reg_message
                text: ""
                font_size: "12sp"
                color: 0.9, 0.2, 0.2, 1
                size_hint_y: None
                height: "20dp"

            Button:
                text: "Daftar"
                size_hint_y: None
                height: "48dp"
                background_normal: ''
                background_color: 0.13, 0.55, 0.35, 1
                color: 1, 1, 1, 1
                bold: True
                on_press: root.do_register()

            BoxLayout:
                orientation: 'horizontal'
                size_hint_y: None
                height: "35dp"
                alignment: 'center'

                Label:
                    text: "Sudah punya akun? "
                    font_size: "12sp"
                    color: 0.5, 0.5, 0.5, 1
                    size_hint_x: None
                    width: self.texture_size[0]

                Button:
                    text: "Masuk"
                    font_size: "12sp"
                    color: 0.13, 0.55, 0.35, 1
                    bold: True
                    background_color: 0, 0, 0, 0
                    size_hint_x: None
                    width: self.texture_size[0]
                    on_press: app.root.current = 'login'

<HomeScreen>:
    MDBoxLayout:
        orientation: 'vertical'
        md_bg_color: get_color_from_hex("#FAF8F5")

        ScrollView:
            do_scroll_x: False

            MDBoxLayout:
                orientation: 'vertical'
                padding: ["20dp", "24dp", "20dp", "20dp"]
                spacing: "16dp"
                size_hint_y: None
                height: self.minimum_height

                MDBoxLayout:
                    orientation: 'vertical'
                    spacing: "4dp"
                    size_hint_y: None
                    height: self.minimum_height
                    padding: [dp(2), 0, 0, 0]

                    MDLabel:
                        id: user_greeting
                        text: "Halo, " + root.user_name + "!"
                        font_style: "H5"
                        bold: True
                        size_hint_y: None
                        height: self.texture_size[1]
                        theme_text_color: "Custom"
                        text_color: get_color_from_hex("#1A1A1A")

                    MDLabel:
                        text: "Semangat kelola keuangan hari ini!"
                        font_style: "Caption"
                        size_hint_y: None
                        height: self.texture_size[1]
                        theme_text_color: "Custom"
                        text_color: get_color_from_hex("#8E8E93")

                MDCard:
                    radius: [20, 20, 20, 20]
                    elevation: 0
                    md_bg_color: 1, 1, 1, 1
                    size_hint_y: None
                    height: dp(54)
                    padding: [dp(12), 0, dp(12), 0]

                    MDBoxLayout:
                        orientation: 'horizontal'

                        MDIconButton:
                            icon: "chevron-left"
                            user_font_size: "20sp"
                            pos_hint: {"center_y": .5}
                            theme_text_color: "Custom"
                            text_color: get_color_from_hex("#1A1A1A")
                            on_release: root.prev_month()

                        Widget:

                        MDBoxLayout:
                            adaptive_size: True
                            spacing: "8dp"
                            pos_hint: {"center_y": .5}

                            MDIcon:
                                icon: "calendar-month-outline"
                                font_size: "18sp"
                                size_hint: None, None
                                size: "18dp", "18dp"
                                pos_hint: {"center_x": .5, "center_y": .5}
                                theme_text_color: "Custom"
                                text_color: get_color_from_hex("#278B58")

                            MDLabel:
                                id: current_month_label
                                text: "September 2026"
                                bold: True
                                adaptive_size: True
                                pos_hint: {"center_y": .5}
                                theme_text_color: "Custom"
                                text_color: get_color_from_hex("#1A1A1A")

                        Widget:

                        MDIconButton:
                            icon: "chevron-right"
                            user_font_size: "20sp"
                            pos_hint: {"center_y": .5}
                            theme_text_color: "Custom"
                            text_color: get_color_from_hex("#1A1A1A")
                            on_release: root.next_month()

                MDCard:
                    radius: [20,]
                    elevation: 0
                    md_bg_color: get_color_from_hex("#278B58")
                    size_hint: 1, None
                    height: dp(100)
                    padding: [dp(18), dp(16), dp(18), dp(16)]

                    MDBoxLayout:
                        orientation: 'horizontal'
                        spacing: dp(14)
                        size_hint_x: 1

                        MDCard:
                            radius: [14,]
                            elevation: 0
                            md_bg_color: 1, 1, 1, 0.18
                            size_hint: None, None
                            size: "48dp", "48dp"
                            pos_hint: {"center_x": .5, "center_y": .5}
                            padding: 0

                            MDRelativeLayout:
                                size: self.parent.size
                                pos_hint: {"center_x": .5, "center_y": .5}

                                MDIcon:
                                    icon: "wallet-outline"
                                    font_size: "24sp"
                                    size_hint: None, None
                                    size: "24dp", "24dp"
                                    pos_hint: {"center_x": .5, "center_y": .5}
                                    theme_text_color: "Custom"
                                    text_color: 1, 1, 1, 1

                        MDBoxLayout:
                            orientation: 'vertical'
                            spacing: "4dp"
                            pos_hint: {"center_y": .5}

                            MDLabel:
                                text: "Saldo Saat Ini"
                                font_style: "Caption"
                                theme_text_color: "Custom"
                                text_color: 1, 1, 1, 0.8

                            MDLabel:
                                id: saldo_label
                                text: "Rp 0"
                                font_style: "H5"
                                bold: True
                                theme_text_color: "Custom"
                                text_color: 1, 1, 1, 1

                MDBoxLayout:
                    spacing: dp(12)
                    size_hint_y: None
                    height: dp(90)
                    size_hint_x: 1

                    MDCard:
                        radius: [18,]
                        elevation: 0
                        md_bg_color: 1, 1, 1, 1
                        size_hint_x: 1
                        padding: [dp(12), dp(10), dp(12), dp(10)]

                        MDBoxLayout:
                            spacing: dp(10)
                            size_hint_x: 1

                            MDCard:
                                radius: [12,]
                                elevation: 0
                                md_bg_color: get_color_from_hex("#E8F5E9")
                                size_hint: None, None
                                size: "38dp", "38dp"
                                pos_hint: {"center_x": .5, "center_y": .5}
                                padding: 0

                                MDRelativeLayout:
                                    size: self.parent.size
                                    pos_hint: {"center_x": .5, "center_y": .5}

                                    MDIcon:
                                        icon: "arrow-up-circle-outline"
                                        font_size: "20sp"
                                        size_hint: None, None
                                        size: "20dp", "20dp"
                                        pos_hint: {"center_x": .5, "center_y": .5}
                                        theme_text_color: "Custom"
                                        text_color: get_color_from_hex("#278B58")

                            MDBoxLayout:
                                orientation: 'vertical'
                                pos_hint: {"center_y": .5}

                                MDLabel:
                                    text: "Total\nPemasukan"
                                    font_style: "Caption"
                                    theme_text_color: "Custom"
                                    text_color: get_color_from_hex("#8E8E93")

                                MDLabel:
                                    id: income_label
                                    text: "Rp 0"
                                    bold: True
                                    font_style: "Subtitle2"
                                    theme_text_color: "Custom"
                                    text_color: get_color_from_hex("#1A1A1A")

                    MDCard:
                        radius: [18,]
                        elevation: 0
                        md_bg_color: 1, 1, 1, 1
                        size_hint_x: 1
                        padding: [dp(12), dp(10), dp(12), dp(10)]

                        MDBoxLayout:
                            spacing: dp(10)
                            size_hint_x: 1

                            MDCard:
                                radius: [12,]
                                elevation: 0
                                md_bg_color: get_color_from_hex("#FFEBEE")
                                size_hint: None, None
                                size: "38dp", "38dp"
                                pos_hint: {"center_x": .5, "center_y": .5}
                                padding: 0

                                MDRelativeLayout:
                                    size: self.parent.size
                                    pos_hint: {"center_x": .5, "center_y": .5}

                                    MDIcon:
                                        icon: "arrow-down-circle-outline"
                                        font_size: "20sp"
                                        size_hint: None, None
                                        size: "20dp", "20dp"
                                        pos_hint: {"center_x": .5, "center_y": .5}
                                        theme_text_color: "Custom"
                                        text_color: get_color_from_hex("#F75A68")

                            MDBoxLayout:
                                orientation: 'vertical'
                                pos_hint: {"center_y": .5}

                                MDLabel:
                                    text: "Total\nPengeluaran"
                                    font_style: "Caption"
                                    theme_text_color: "Custom"
                                    text_color: get_color_from_hex("#8E8E93")

                                MDLabel:
                                    id: expense_label
                                    text: "Rp 0"
                                    bold: True
                                    font_style: "Subtitle2"
                                    theme_text_color: "Custom"
                                    text_color: get_color_from_hex("#1A1A1A")

                MDBoxLayout:
                    spacing: dp(12)
                    size_hint_y: None
                    height: dp(85)
                    size_hint_x: 1

                    MDCard:
                        radius: [18,]
                        elevation: 0
                        md_bg_color: get_color_from_hex("#278B58")
                        on_release: root.open_income()
                        size_hint_x: 1
                        padding: [dp(14), dp(10), dp(14), dp(10)]

                        MDBoxLayout:
                            orientation: 'vertical'
                            spacing: dp(5)
                            size_hint_x: 1

                            MDCard:
                                radius: [8,]
                                elevation: 0
                                md_bg_color: 1, 1, 1, 0.2
                                size_hint: None, None
                                size: "28dp", "28dp"
                                pos_hint: {"center_x": .5, "center_y": .5}
                                padding: 0

                                MDRelativeLayout:
                                    size: self.parent.size
                                    pos_hint: {"center_x": .5, "center_y": .5}

                                    MDIcon:
                                        icon: "plus"
                                        font_size: "18sp"
                                        size_hint: None, None
                                        size: "18dp", "18dp"
                                        pos_hint: {"center_x": .5, "center_y": .5}
                                        theme_text_color: "Custom"
                                        text_color: 1, 1, 1, 1

                            Widget:

                            MDLabel:
                                text: "Pemasukan"
                                bold: True
                                theme_text_color: "Custom"
                                text_color: 1, 1, 1, 1

                    MDCard:
                        radius: [18,]
                        elevation: 0
                        md_bg_color: get_color_from_hex("#F75A68")
                        on_release: root.open_expense()
                        size_hint_x: 1
                        padding: [dp(14), dp(10), dp(14), dp(10)]

                        MDBoxLayout:
                            orientation: 'vertical'
                            spacing: dp(5)
                            size_hint_x: 1

                            MDCard:
                                radius: [8,]
                                elevation: 0
                                md_bg_color: 1, 1, 1, 0.2
                                size_hint: None, None
                                size: "28dp", "28dp"
                                pos_hint: {"center_x": .5, "center_y": .5}
                                padding: 0

                                MDRelativeLayout:
                                    size: self.parent.size
                                    pos_hint: {"center_x": .5, "center_y": .5}

                                    MDIcon:
                                        icon: "minus"
                                        font_size: "18sp"
                                        size_hint: None, None
                                        size: "18dp", "18dp"
                                        pos_hint: {"center_x": .5, "center_y": .5}
                                        theme_text_color: "Custom"
                                        text_color: 1, 1, 1, 1

                            Widget:

                            MDLabel:
                                text: "Pengeluaran"
                                bold: True
                                theme_text_color: "Custom"
                                text_color: 1, 1, 1, 1

                MDCard:
                    radius: [18,]
                    elevation: 0
                    md_bg_color: get_color_from_hex("#33A2C4")
                    size_hint: 1, None
                    height: dp(85)
                    on_release: root.show_logout_dialog()
                    padding: [dp(14), dp(10), dp(14), dp(10)]

                    MDBoxLayout:
                        orientation: 'vertical'
                        spacing: dp(5)
                        size_hint_x: 1

                        MDCard:
                            radius: [8,]
                            elevation: 0
                            md_bg_color: 1, 1, 1, 0.2
                            size_hint: None, None
                            size: "28dp", "28dp"
                            pos_hint: {"center_x": .5, "center_y": .5}
                            padding: 0

                            MDRelativeLayout:
                                size: self.parent.size
                                pos_hint: {"center_x": .5, "center_y": .5}

                                MDIcon:
                                    icon: "power"
                                    font_size: "18sp"
                                    size_hint: None, None
                                    size: "18dp", "18dp"
                                    pos_hint: {"center_x": .5, "center_y": .5}
                                    theme_text_color: "Custom"
                                    text_color: 1, 1, 1, 1

                        Widget:

                        MDLabel:
                            text: "Keluar dari Akun"
                            bold: True
                            theme_text_color: "Custom"
                            text_color: 1, 1, 1, 1

                MDCard:
                    radius: [18,]
                    elevation: 0
                    md_bg_color: get_color_from_hex("#F3EFE6")
                    size_hint_y: None
                    height: "70dp"
                    padding: ["16dp", "8dp", "16dp", "8dp"]

                    MDLabel:
                        text: '"Kelola keuangan mulai dari hal kecil\nuntuk masa depan yang lebih baik"'
                        font_style: "Caption"
                        italic: True
                        halign: "center"
                        valign: "center"
                        theme_text_color: "Custom"
                        text_color: get_color_from_hex("#8E8E93")

        MDCard:
            radius: [0, 0, 0, 0]
            elevation: 0
            md_bg_color: 1, 1, 1, 1
            size_hint: 1, None
            height: dp(64)
            padding: [dp(8), dp(4), dp(8), dp(4)]

            MDBoxLayout:
                orientation: 'horizontal'
                size_hint_x: 1

                MDBoxLayout:
                    orientation: 'vertical'
                    padding: ["0dp", "8dp", "0dp", "8dp"]
                    spacing: "2dp"

                    MDIcon:
                        icon: "home"
                        font_size: "20sp"
                        size_hint: None, None
                        size: "20dp", "20dp"
                        pos_hint: {"center_x": .5, "center_y": .5}
                        theme_text_color: "Custom"
                        text_color: get_color_from_hex("#278B58")

                    MDLabel:
                        text: "Beranda"
                        halign: "center"
                        bold: True
                        font_style: "Caption"
                        theme_text_color: "Custom"
                        text_color: get_color_from_hex("#278B58")

                MDBoxLayout:
                    orientation: 'vertical'
                    padding: ["0dp", "8dp", "0dp", "8dp"]
                    spacing: "2dp"
                    on_touch_down: if self.collide_point(*args[1].pos): root.go_to_statistic()

                    MDIcon:
                        icon: "arrow-top-right"
                        font_size: "20sp"
                        size_hint: None, None
                        size: "20dp", "20dp"
                        pos_hint: {"center_x": .5, "center_y": .5}
                        theme_text_color: "Custom"
                        text_color: get_color_from_hex("#8E8E93")

                    MDLabel:
                        text: "Statistik"
                        halign: "center"
                        font_style: "Caption"
                        theme_text_color: "Custom"
                        text_color: get_color_from_hex("#8E8E93")

                MDBoxLayout:
                    orientation: 'vertical'
                    padding: ["0dp", "8dp", "0dp", "8dp"]
                    spacing: "2dp"
                    on_touch_down: if self.collide_point(*args[1].pos): root.manager.current = "history"

                    MDIcon:
                        icon: "text-box-outline"
                        font_size: "20sp"
                        size_hint: None, None
                        size: "20dp", "20dp"
                        pos_hint: {"center_x": .5, "center_y": .5}
                        theme_text_color: "Custom"
                        text_color: get_color_from_hex("#8E8E93")

                    MDLabel:
                        text: "Riwayat"
                        halign: "center"
                        font_style: "Caption"
                        theme_text_color: "Custom"
                        text_color: get_color_from_hex("#8E8E93")

<IncomeScreen>:
    MDBoxLayout:
        orientation: 'vertical'
        md_bg_color: get_color_from_hex("#FAF8F5")
        padding: ["20dp", "16dp", "20dp", "20dp"]
        spacing: "12dp"

        MDBoxLayout:
            size_hint_y: None
            height: "42dp"
            spacing: "12dp"

            MDIconButton:
                icon: "chevron-left"
                user_font_size: "24sp"
                pos_hint: {"center_y": .5}
                theme_text_color: "Custom"
                text_color: get_color_from_hex("#1A1A1A")
                on_release: root.manager.current = "home"

            MDLabel:
                text: "Pemasukan"
                font_style: "H6"
                bold: True
                pos_hint: {"center_y": .5}
                theme_text_color: "Custom"
                text_color: get_color_from_hex("#1A1A1A")

        MDCard:
            radius: [12,]
            elevation: 0
            md_bg_color: get_color_from_hex("#278B58")
            size_hint: None, None
            size: "228dp", "44dp"
            padding: ["10dp", "0dp", "10dp", "0dp"]

            MDBoxLayout:
                spacing: "8dp"
                pos_hint: {"center_y": .5}

                MDIcon:
                    icon: "plus"
                    user_font_size: "18sp"
                    pos_hint: {"center_y": .5}
                    theme_text_color: "Custom"
                    text_color: 1, 1, 1, 1

                MDLabel:
                    text: "Tambah Pemasukan"
                    font_style: "Caption"
                    bold: True
                    pos_hint: {"center_y": .5}
                    theme_text_color: "Custom"
                    text_color: 1, 1, 1, 1

        ScrollView:
            do_scroll_x: False

            MDBoxLayout:
                orientation: 'vertical'
                spacing: "12dp"
                padding: [0, "4dp", 0, "20dp"]
                size_hint_y: None
                height: self.minimum_height

                MDBoxLayout:
                    orientation: 'vertical'
                    spacing: "4dp"
